# Copie para .env e substitua TODOS os valores antes de qualquer utilização real.
# Nunca faça commit do ficheiro .env.

# Base de dados central (conta com permissão para criar bases e funções)
CENTRAL_DATABASE_URL="postgresql://nc_admin:TROCAR_PASSWORD@127.0.0.1:5432/nc_central"

# Chave de cifra (mínimo 32 caracteres aleatórios). Gere com: openssl rand -base64 48
APP_SECRET="TROCAR_POR_VALOR_ALEATORIO_DE_32_OU_MAIS_CARACTERES"

# Endereço público da aplicação (com https:// em produção)
APP_URL="https://noscrianca.exemplo.cv"

# Ficheiros enviados (fotos, documentos, logótipos, comprovativos) e cópias de segurança
STORAGE_DIR="./storage"
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=14
MAX_TENANT_POOLS=50

# Conta da plataforma (Super Administrador), criada na primeira execução
SUPERADMIN_EMAIL="admin@exemplo.cv"
SUPERADMIN_NAME="Super Administrador"
SUPERADMIN_PASSWORD="TROCAR_PALAVRA_PASSE_FORTE"

# Email transacional (convites e redefinição de palavra-passe). Se vazio, o link é mostrado no ecrã.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NosCriança <no-reply@exemplo.cv>"
# Envio de emails (recomendado: Resend). Se RESEND_API_KEY estiver vazio, usa-se SMTP.
RESEND_API_KEY=""
EMAIL_FROM="NosCriança <cobranca@exemplo.cv>"
